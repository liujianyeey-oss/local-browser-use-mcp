{
  "name": "local-browser-use-mcp",
  "version": "0.1.1",
  "description": "Unofficial local stdio MCP bridge for an installed OpenAI Browser Runtime",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "liujianyeey-oss (https://github.com/liujianyeey-oss)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liujianyeey-oss/local-browser-use-mcp.git"
  },
  "homepage": "https://github.com/liujianyeey-oss/local-browser-use-mcp#readme",
  "bugs": {
    "url": "https://github.com/liujianyeey-oss/local-browser-use-mcp/issues"
  },
  "bin": {
    "local-browser-use-mcp": "bin/local-browser-use-mcp.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "examples/",
    "docs/README.zh-CN.md",
    "skills/local-browser-use/SKILL.md",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node scripts/run-tests.mjs",
    "verify": "npm run check && npm test && npm run verify:package",
    "verify:package": "node scripts/verify-package.mjs",
    "smoke": "node scripts/probe-readonly-inventory.mjs",
    "smoke:tab": "node scripts/probe-example-tab.mjs",
    "prepublishOnly": "npm run verify"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin"
  ],
  "keywords": [
    "mcp",
    "browser-automation",
    "chrome",
    "agent-cli",
    "chatgpt",
    "codex"
  ],
  "publishConfig": {
    "access": "public"
  }
}
